{
  "name": "@muigui/tendril-monorepo",
  "author": "Christos Constandinou <christos@muigui.com> (https://github.com/constantology)",
  "description": "muigui | Tendril | Monorepo",
  "license": "Apache-2.0",
  "maintainers": [
    {
      "email": "christos@muigui.com",
      "name": "Christos Constandinou",
      "url": "https://github.com/constantology"
    }
  ],
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "build": "npm run build --if-present --workspaces",
    "clean": "npm run clean --if-present --workspaces",
    "lint": "npm run lint --if-present --workspaces",
    "lint:fix": "npm run lint:fix --if-present --workspaces",
    "lint:fix:all": "npm run lint:fix:all --if-present --workspaces",
    "postws:clean:install": "npm run build",
    "preclean": "rm -rf node_modules",
    "prews:clean:install": "npm run clean",
    "test": "npm run test --if-present --workspaces",
    "ws:ci": "npm run ws:clean-install",
    "ws:clean-install": "npm ci --include-workspace-root --workspaces",
    "ws:clean:install": "npm run ws:install",
    "ws:i": "npm run ws:install",
    "ws:install": "npm install --include-workspace-root --workspaces"
  },
  "dependencies": {
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@muigui/code-style": "^1.0.3",
    "@types/node": "^26.4.1",
    "@types/shelljs": "^0.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "npm-check-updates": "^23.1.0",
    "shelljs": "^0.10.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.13.1",
    "npm": ">=11.8.0"
  },
  "packageManager": "npm@11.8.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/muigui/tendril.git"
  },
  "workspaces": [
    "./workspaces/tendril-core",
    "./workspaces/tendril-test-fixtures",
    "./workspaces/tendril-test-utils",
    "./workspaces/tendril-api"
  ]
}
